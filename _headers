# Social card is NOT content-hashed, so it must never be immutable.
# Listed first so it wins over the /assets/* rule below.
/assets/og-*.png
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# Build assets are content-hashed, so cache hard.
# ACAO is required because Vite emits <link crossorigin> / <script crossorigin>,
# which makes browsers (Safari strictly) treat these as CORS requests.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/brand/*
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *

# Always revalidate HTML so deploys go live immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# Baseline security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
